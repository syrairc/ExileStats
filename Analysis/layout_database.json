{
  "schema_version": 3,
  "description": "Layout + size + monster-density database for maps, keyed by MapId. Primary data source is the ExileStats plugin (maps/<MapId>_<instance>/run.json + map.svg). Layout judged ONLY from wall/room structure (in SVGs grey=walkable, white holes=obstacles); colored objective lines are ignored. Maps can have multiple instances/runs; stats are aggregated per MapId.",
  "last_updated": "2026-06-13",
  "data_sources": {
    "stats": "ExileStats/maps/<folder>/run.json (per run)",
    "layout_image": "map.svg (newer) or legacy Radar PNG",
    "runs_index": "ExileStats/maps/index.json"
  },
  "layout_types": {
    "linear": "A single long path/corridor to a boss room at the far end.",
    "open_obstacles": "One large open area scattered with discrete obstacles; free-roam, no defined corridor.",
    "converging_branches": "Multiple diverging paths that funnel back to a single boss room (Trenches pattern).",
    "central_loop": "A ring of rooms with the boss arena in the CENTRE (Augury pattern).",
    "grid_network": "A dense interconnected web of rooms with multiple parallel routes and side branches.",
    "corridors": "A sparse skeleton of narrow (~single-width) passages linking discrete rooms, with large non-walkable gaps between them (low walkable fill). Distinct from grid_network, which is a denser web of thicker, adjoining rooms.",
    "perimeter_loop": "A walkable ring wrapping a large EMPTY central void (boss usually on a spur).",
    "boss_arena": "Dedicated boss-fight map: short approach to a single boss room, minimal trash (MonstersTotal ~1).",
    "unclassified": "No layout image yet, or does not clearly fit a type."
  },
  "size_method": "Map size = AreaWidth x AreaHeight from run.json (in-game grid units), median across runs. Replaces the old image-pixel footprint (schema v2).",
  "density_methodology": {
    "metric": "monsters_per_megagrid (monsters per 1,000,000 grid^2 of map area)",
    "formula": "median(MonstersTotal of full-clear runs) / (area_grid / 1,000,000)",
    "full_clear_filter": "a run counts as a full clear if duration >= 30s AND MonstersTotal >= 50; abandoned/near-entry runs are excluded as low outliers",
    "rating_bands_provisional": {
      "very_low": "<60",
      "low": "60-79",
      "medium": "80-94",
      "high": "95-134",
      "very_high": ">=135"
    },
    "note": "Bands are PROVISIONAL, derived from the quartiles of current observed densities (~45-200). Recalibrate as more full-clear runs accumulate. Maps with no full clear yet, or older runs lacking AreaWidth/Height, show density null with a reason."
  },
